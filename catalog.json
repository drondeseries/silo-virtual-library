{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "com.drondeseries.silo-virtual-library",
        "version": "0.4.34",
        "silo_api_version": "v1",
        "capabilities": [
          {
            "type": "virtual_stream_provider.v1",
            "id": "stremio-stream-resolver",
            "display_name": "Virtual Stream Provider",
            "description": "Resolves provider-neutral virtual media into ranked, temporary stream candidates.",
            "virtual_stream_provider": {
              "supported_media_types": [
                "movie",
                "series",
                "episode"
              ],
              "supports_just_in_time_resolution": true,
              "supports_multiple_candidates": true
            }
          },
          {
            "type": "request_router.v1",
            "id": "virtual-library-requests",
            "display_name": "Virtual Library Requests",
            "description": "Registers home-released media immediately and queues upcoming media for monitoring.",
            "metadata": {
              "connection_defaults": {
                "base_url": "plugin://virtual-library",
                "api_key": "plugin-managed"
              }
            },
            "config_schema": [
              {
                "key": "connection",
                "json_schema": "{\"type\":\"object\",\"properties\":{}}",
                "admin_form": {
                  "fields": []
                }
              }
            ]
          },
          {
            "type": "scheduled_task.v1",
            "id": "monitor-media",
            "display_name": "Monitor Queued Media",
            "description": "Checks queued media for home release and adds newly aired series episodes."
          }
        ],
        "presentation": {
          "display_name": "Silo Virtual Library",
          "summary": "Zero-storage virtual playback backed by dynamic streaming provider resolution.",
          "description_markdown": "Registers and resolves host-managed `virtual://` virtual media through Silo's authenticated plugin control plane, without database credentials or stored media files.",
          "setup_markdown": "Before enabling the request integration, enter the complete secret streaming provider manifest URL and pick one Movies library and one Series library from the host\u2019s library list. Add an optional TMDB token for authoritative worldwide digital/physical release gating. No database URL or media path is required.",
          "homepage_url": "https://github.com/drondeseries/silo-virtual-library",
          "source_url": "https://github.com/drondeseries/silo-virtual-library",
          "support_url": "https://github.com/drondeseries/silo-virtual-library/issues",
          "changelog_url": "https://github.com/drondeseries/silo-virtual-library/releases",
          "publisher_name": "drondeseries",
          "publisher_url": "https://github.com/drondeseries",
          "license_spdx": "NOASSERTION"
        },
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "global_config_schema": [
          {
            "key": "streaming",
            "title": "streaming provider",
            "description": "Connection to the configured streaming provider Stremio addon.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"manifest_url\":{\"type\":\"string\",\"format\":\"uri\",\"maxLength\":4096},\"movie_library_id\":{\"type\":\"integer\",\"minimum\":1,\"default\":1},\"series_library_id\":{\"type\":\"integer\",\"minimum\":1,\"default\":2},\"tmdb_api_key\":{\"type\":\"string\",\"maxLength\":4096},\"monitor_file\":{\"type\":\"string\",\"maxLength\":4096,\"default\":\".silo-virtual-library-monitored.json\"},\"allow_insecure_http\":{\"type\":\"boolean\",\"default\":false},\"cache_ttl_minutes\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10080,\"default\":10},\"enable_quality_profiles\":{\"type\":\"boolean\",\"default\":false},\"quality_profiles\":{\"type\":\"array\",\"maxItems\":10,\"items\":{\"type\":\"object\",\"properties\":{\"label\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":128},\"resolution\":{\"type\":\"string\",\"maxLength\":64},\"include_regex\":{\"type\":\"string\",\"maxLength\":1024},\"exclude_regex\":{\"type\":\"string\",\"maxLength\":1024},\"preferred_order\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":10000},\"codec_video\":{\"type\":\"string\",\"maxLength\":64},\"codec_audio\":{\"type\":\"string\",\"maxLength\":64},\"hdr\":{\"type\":\"string\",\"maxLength\":64}},\"required\":[\"label\"],\"additionalProperties\":false}},\"fallback_to_any_stream\":{\"type\":\"boolean\",\"default\":false}},\"required\":[\"manifest_url\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "movie_library_id",
                  "label": "Movies Library",
                  "description": "Destination Silo Movies library. Need one? Create it at [Settings -> Libraries](/admin/libraries) and use the \"Add Virtual\" button on the Folders tab \u2014 no local storage required.",
                  "control": 3,
                  "dynamic_options": true,
                  "required": false
                },
                {
                  "key": "series_library_id",
                  "label": "Series Library",
                  "description": "Destination Silo Series library. Need one? Create it at [Settings -> Libraries](/admin/libraries) and use the \"Add Virtual\" button on the Folders tab \u2014 no local storage required.",
                  "control": 3,
                  "dynamic_options": true,
                  "required": false
                },
                {
                  "key": "manifest_url",
                  "label": "Manifest URL",
                  "description": "The complete tokenized streaming provider URL ending in /manifest.json.",
                  "control": 3,
                  "placeholder": "https://\u2026/manifest.json",
                  "required": true,
                  "secret": true
                },
                {
                  "key": "tmdb_api_key",
                  "label": "TMDB API Token",
                  "description": "Optional TMDB v4 token or v3 API key used to distinguish theatrical from home-media releases.",
                  "control": 3,
                  "secret": true
                },
                {
                  "key": "allow_insecure_http",
                  "label": "Allow local HTTP",
                  "description": "Allow plain HTTP only for localhost, .local, single-label Docker/service names, or private IPs. HTTPS remains the default.",
                  "control": 5
                },
                {
                  "key": "cache_ttl_minutes",
                  "label": "Candidate Cache TTL (minutes)",
                  "description": "How long provider stream candidates are cached (1\u201310080 minutes).",
                  "control": 4,
                  "placeholder": "10"
                },
                {
                  "key": "monitor_file",
                  "label": "Monitored Queue File",
                  "description": "Writable path used to persist queued media across plugin restarts.",
                  "control": 1,
                  "placeholder": ".silo-virtual-library-monitored.json"
                },
                {
                  "key": "enable_quality_profiles",
                  "label": "Enable Quality Profiles",
                  "description": "Use configurable quality profiles to match streaming provider.",
                  "control": 5
                },
                {
                  "key": "quality_profiles",
                  "label": "Quality Profiles",
                  "description": "Configure profiles with constraints.",
                  "control": 2,
                  "rows": 6
                },
                {
                  "key": "fallback_to_any_stream",
                  "label": "Fallback to Any Stream",
                  "description": "Return 1 stream if no profiles match.",
                  "control": 5
                }
              ],
              "submit_label": "Save streaming provider connection"
            }
          }
        ]
      },
      "repo_url": "https://github.com/drondeseries/silo-virtual-library",
      "checksums_url": "https://github.com/drondeseries/silo-virtual-library/releases/download/v0.4.34/checksums.txt",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/drondeseries/silo-virtual-library/releases/download/v0.4.34/plugin-linux-amd64",
          "checksum": ""
        },
        "linux/arm64": {
          "url": "https://github.com/drondeseries/silo-virtual-library/releases/download/v0.4.34/plugin-linux-arm64",
          "checksum": ""
        },
        "darwin/arm64": {
          "url": "https://github.com/drondeseries/silo-virtual-library/releases/download/v0.4.34/plugin-darwin-arm64",
          "checksum": ""
        }
      }
    }
  ]
}
